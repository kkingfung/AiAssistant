<Window x:Class="AiAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="AiAssistant" Width="360" Height="400"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_MouseRightButtonUp">

    <Window.Resources>
        <!-- ドロップシャドウエフェクト -->
        <DropShadowEffect x:Key="DropShadowEffect"
                         Color="Black"
                         Opacity="0.3"
                         BlurRadius="10"
                         ShadowDepth="2"/>
    </Window.Resources>

    <Grid>
        <!-- ボタンパネル（右上） -->
        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="5"
                    Panel.ZIndex="100">
            <!-- チャットボタン -->
            <Button Content="💬"
                    Width="28"
                    Height="28"
                    Margin="0,0,5,0"
                    Background="#88000000"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="16"
                    Cursor="Hand"
                    Click="OnChatButtonClick"
                    ToolTip="チャット">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC1E90FF"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 閉じるボタン -->
            <Button Content="×"
                    Width="28"
                    Height="28"
                    Background="#88000000"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="18"
                    FontWeight="Bold"
                    Cursor="Hand"
                    Click="OnCloseButtonClick"
                    ToolTip="閉じる">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CCFF0000"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- クイックアクションボタンパネル（右側・縦） -->
        <StackPanel Orientation="Vertical"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,40,5,0"
                    Panel.ZIndex="100">
            <!-- クイックアクションメニュー（情報系） -->
            <Button Content="⚡"
                    Width="28"
                    Height="28"
                    Margin="0,0,0,3"
                    Background="#8800AA00"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="OnQuickActionsButtonClick"
                    ToolTip="クイックアクション">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC00CC00"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ツールメニュー（開発・連携系） -->
            <Button Content="🔧"
                    Width="28"
                    Height="28"
                    Margin="0,0,0,3"
                    Background="#88333333"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="OnToolsButtonClick"
                    ToolTip="ツール">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC555555"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 教育機能メニュー -->
            <Button Content="📚"
                    Width="28"
                    Height="28"
                    Margin="0,0,0,3"
                    Background="#889C27B0"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="OnEducationButtonClick"
                    ToolTip="教育（言語・プログラミング学習）">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CCAB47BC"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 設定メニュー -->
            <Button Content="⚙️"
                    Width="28"
                    Height="28"
                    Margin="0,0,0,3"
                    Background="#88607D8B"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="OnSettingsButtonClick"
                    ToolTip="設定">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC78909C"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 音楽プレーヤー -->
            <Button x:Name="MusicButton"
                    Content="🎵"
                    Width="28"
                    Height="28"
                    Margin="0,0,0,3"
                    Background="#88E91E63"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="OnMusicButtonClick"
                    ToolTip="音楽プレーヤー">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CCE91E63"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- ウィジェットモード切替 -->
            <Button x:Name="WidgetModeButton"
                    Content="📌"
                    Width="28"
                    Height="28"
                    Margin="0,0,0,3"
                    Background="#8800BCD4"
                    Foreground="White"
                    BorderThickness="0"
                    FontSize="14"
                    Cursor="Hand"
                    Click="OnWidgetModeButtonClick"
                    ToolTip="ウィジェットモード">
                <Button.Style>
                    <Style TargetType="Button">
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="Button">
                                    <Border Background="{TemplateBinding Background}"
                                            CornerRadius="14">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                         VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#CC00BCD4"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>

        <!-- キャラクター表示エリア（ドラッグ可能） -->
        <Border x:Name="CharacterBorder"
                CornerRadius="12"
                HorizontalAlignment="Right" VerticalAlignment="Bottom"
                Background="Transparent"
                Padding="5"
                Margin="0,40,5,5"
                MouseLeftButtonDown="Window_MouseLeftButtonDown"
                Cursor="SizeAll">
            <Grid>
                <!-- Live2D表示用WebView2（Phase 2） -->
                <wv2:WebView2 x:Name="Live2DWebView"
                              Width="300" Height="350"
                              Visibility="Collapsed"
                              DefaultBackgroundColor="Transparent"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"/>

                <!-- アバター画像またはプレースホルダー -->
                <Image x:Name="AvatarImage"
                       Stretch="Uniform"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>

                <!-- プレースホルダー（アバターがない場合） -->
                <Viewbox x:Name="PlaceholderViewbox" Stretch="Uniform">
                    <Grid Width="200" Height="260">
                        <!-- プレースホルダー：円形アバター -->
                        <Ellipse Width="100" Height="100"
                                Fill="LightGray"
                                Opacity="0.3"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,60"/>

                        <!-- プレースホルダー：テキスト -->
                        <TextBlock Text="AI助理"
                                  Foreground="Gray"
                                  FontWeight="Bold"
                                  FontSize="18"
                                  Opacity="0.5"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,20"/>

                        <!-- 状態インジケーター -->
                        <TextBlock x:Name="StateIndicator"
                                  Text="{Binding StateText}"
                                  Foreground="White"
                                  FontSize="12"
                                  Opacity="0.7"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,2"/>
                    </Grid>
                </Viewbox>
            </Grid>
        </Border>

        <!-- チャットバルーンポップアップ -->
        <Border x:Name="ChatBalloon"
                Width="340"
                Height="380"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10,0,0,10"
                Background="#F0FFFFFF"
                CornerRadius="12"
                Padding="0"
                Visibility="Collapsed"
                IsHitTestVisible="True"
                Effect="{StaticResource DropShadowEffect}"
                Panel.ZIndex="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ヘッダー -->
                <Border Grid.Row="0"
                        Background="#FF1E90FF"
                        CornerRadius="12,12,0,0"
                        Padding="12,8">
                    <Grid>
                        <TextBlock Text="チャット"
                                  Foreground="White"
                                  FontWeight="Bold"
                                  FontSize="14"
                                  VerticalAlignment="Center"/>
                        <Button Content="×"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="OnCloseChatClick"/>
                    </Grid>
                </Border>

                <!-- メッセージ表示エリア -->
                <ScrollViewer Grid.Row="1"
                             x:Name="ChatScrollViewer"
                             VerticalScrollBarVisibility="Auto"
                             Padding="12">
                    <StackPanel x:Name="ChatMessagesPanel"
                               Orientation="Vertical"/>
                </ScrollViewer>

                <!-- 入力エリア -->
                <Border Grid.Row="2"
                        Background="#FFF5F5F5"
                        CornerRadius="0,0,12,12"
                        Padding="12"
                        BorderBrush="#FFDDDDDD"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                BorderBrush="#FFCCCCCC"
                                BorderThickness="1"
                                CornerRadius="4">
                            <TextBox x:Name="ChatInputBox"
                                    MinHeight="32"
                                    MaxHeight="100"
                                    Padding="8"
                                    VerticalAlignment="Center"
                                    TextWrapping="Wrap"
                                    AcceptsReturn="False"
                                    BorderThickness="0"
                                    Background="White"
                                    IsEnabled="True"
                                    Focusable="True"
                                    KeyDown="OnChatInputKeyDown"/>
                        </Border>

                        <!-- 音声入力ボタン -->
                        <Border Grid.Column="1"
                                x:Name="VoiceInputButtonBorder"
                                Margin="6,0,0,0"
                                Background="#FF9C27B0"
                                CornerRadius="4"
                                Cursor="Hand">
                            <Button x:Name="VoiceInputButton"
                                    Content="🎤"
                                    Width="36"
                                    Height="32"
                                    Background="Transparent"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontSize="16"
                                    Cursor="Hand"
                                    ToolTip="音声入力"
                                    Click="OnVoiceInputButtonClick"/>
                        </Border>

                        <Border Grid.Column="2"
                                Margin="6,0,0,0"
                                Background="#FF1E90FF"
                                CornerRadius="4"
                                Cursor="Hand">
                            <Button x:Name="SendButton"
                                    Content="送信"
                                    Width="60"
                                    Height="32"
                                    Background="Transparent"
                                    Foreground="White"
                                    BorderThickness="0"
                                    FontWeight="Bold"
                                    Cursor="Hand"
                                    Click="OnSendMessageClick"/>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- ペット選択ポップアップ -->
        <Border x:Name="PetSelectorPopup"
                Width="240"
                Height="280"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,40,10,0"
                Background="#F0FFFFFF"
                CornerRadius="12"
                Padding="0"
                Visibility="Collapsed"
                IsHitTestVisible="True"
                Effect="{StaticResource DropShadowEffect}"
                Panel.ZIndex="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ヘッダー -->
                <Border Grid.Row="0"
                        Background="#FF9370DB"
                        CornerRadius="12,12,0,0"
                        Padding="12,8">
                    <Grid>
                        <TextBlock Text="ペット選択"
                                  Foreground="White"
                                  FontWeight="Bold"
                                  FontSize="14"
                                  VerticalAlignment="Center"/>
                        <Button Content="×"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="OnClosePetSelectorClick"/>
                    </Grid>
                </Border>

                <!-- ペットリスト -->
                <ScrollViewer Grid.Row="1"
                             VerticalScrollBarVisibility="Auto"
                             Padding="8">
                    <StackPanel x:Name="PetListPanel">
                        <!-- Cat -->
                        <Border Margin="0,4" Background="White" BorderBrush="#DDDDDD"
                                BorderThickness="1" CornerRadius="6">
                            <Button x:Name="PetCatButton" Tag="Cat" Click="OnPetSelected"
                                    Padding="12,8" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" HorizontalContentAlignment="Left">
                                <TextBlock Text="🐱 Cat (HellCat)" FontSize="14"/>
                            </Button>
                        </Border>

                        <!-- Crab -->
                        <Border Margin="0,4" Background="White" BorderBrush="#DDDDDD"
                                BorderThickness="1" CornerRadius="6">
                            <Button x:Name="PetCrabButton" Tag="Crab" Click="OnPetSelected"
                                    Padding="12,8" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" HorizontalContentAlignment="Left">
                                <TextBlock Text="🦀 Crab (SciFi)" FontSize="14"/>
                            </Button>
                        </Border>

                        <!-- Dragon -->
                        <Border Margin="0,4" Background="White" BorderBrush="#DDDDDD"
                                BorderThickness="1" CornerRadius="6">
                            <Button x:Name="PetDragonButton" Tag="Dragon" Click="OnPetSelected"
                                    Padding="12,8" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" HorizontalContentAlignment="Left">
                                <TextBlock Text="🐉 Dragon (SciFi)" FontSize="14"/>
                            </Button>
                        </Border>

                        <!-- Frog -->
                        <Border Margin="0,4" Background="White" BorderBrush="#DDDDDD"
                                BorderThickness="1" CornerRadius="6">
                            <Button x:Name="PetFrogButton" Tag="Frog" Click="OnPetSelected"
                                    Padding="12,8" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" HorizontalContentAlignment="Left">
                                <TextBlock Text="🐸 Frog (SciFi)" FontSize="14"/>
                            </Button>
                        </Border>

                        <!-- Shark -->
                        <Border Margin="0,4" Background="White" BorderBrush="#DDDDDD"
                                BorderThickness="1" CornerRadius="6">
                            <Button x:Name="PetSharkButton" Tag="Shark" Click="OnPetSelected"
                                    Padding="12,8" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" HorizontalContentAlignment="Left">
                                <TextBlock Text="🦈 Shark (SciFi)" FontSize="14"/>
                            </Button>
                        </Border>

                        <!-- Snake -->
                        <Border Margin="0,4" Background="White" BorderBrush="#DDDDDD"
                                BorderThickness="1" CornerRadius="6">
                            <Button x:Name="PetSnakeButton" Tag="Snake" Click="OnPetSelected"
                                    Padding="12,8" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" HorizontalContentAlignment="Left">
                                <TextBlock Text="🐍 Snake (SciFi)" FontSize="14"/>
                            </Button>
                        </Border>

                        <!-- Random -->
                        <Border Margin="0,4" Background="#FFF0F0F0" BorderBrush="#DDDDDD"
                                BorderThickness="1" CornerRadius="6">
                            <Button x:Name="PetRandomButton" Tag="Random" Click="OnPetSelected"
                                    Padding="12,8" Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" HorizontalContentAlignment="Left">
                                <TextBlock Text="🎲 Random (All Pets)" FontSize="14" FontWeight="Bold"/>
                            </Button>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>


        <!-- キャラクターセリフ表示バブル（Phase 3） -->
        <Border x:Name="DialogueBubble"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Margin="10,0,0,60"
                MinWidth="180"
                MaxWidth="280"
                Background="#F5FFFFFF"
                CornerRadius="12"
                Padding="0"
                Visibility="Collapsed"
                Effect="{StaticResource DropShadowEffect}"
                Panel.ZIndex="150"
                MouseLeftButtonDown="OnDialogueBubbleClick">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- キャラクター名ヘッダー -->
                <Border Grid.Row="0"
                        Background="#FFFFC0CB"
                        CornerRadius="12,12,0,0"
                        Padding="12,6">
                    <Grid>
                        <TextBlock x:Name="DialogueCharacterName"
                                  Text="ユキ"
                                  Foreground="#FF8B4513"
                                  FontWeight="Bold"
                                  FontSize="12"
                                  VerticalAlignment="Center"/>
                        <Button x:Name="DialogueDismissButton"
                                Content="×"
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="#FF8B4513"
                                FontSize="14"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="OnDialogueDismissClick"
                                ToolTip="閉じる"/>
                    </Grid>
                </Border>

                <!-- セリフ本文 -->
                <Border Grid.Row="1"
                        Background="Transparent"
                        Padding="12,10">
                    <TextBlock x:Name="DialogueText"
                              Text="こんにちは！今日も一緒にがんばりましょうね。"
                              Foreground="#FF333333"
                              FontSize="13"
                              TextWrapping="Wrap"
                              LineHeight="20"/>
                </Border>

                <!-- 吹き出しの尻尾（三角形） -->
                <Polygon Grid.Row="1"
                         Points="0,0 15,0 0,15"
                         Fill="#F5FFFFFF"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,20,-10"/>
            </Grid>
        </Border>

        <!-- 音楽プレーヤーポップアップ -->
        <Border x:Name="MusicPlayerPopup"
                Width="260"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="10,40,0,0"
                Background="#F0FFFFFF"
                CornerRadius="12"
                Padding="0"
                Visibility="Collapsed"
                Effect="{StaticResource DropShadowEffect}"
                Panel.ZIndex="200">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ヘッダー -->
                <Border Grid.Row="0"
                        Background="#FFE91E63"
                        CornerRadius="12,12,0,0"
                        Padding="12,8">
                    <Grid>
                        <TextBlock Text="🎵 Music"
                                  Foreground="White"
                                  FontWeight="Bold"
                                  FontSize="14"
                                  VerticalAlignment="Center"/>
                        <Button Content="×"
                                Width="24"
                                Height="24"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderThickness="0"
                                Foreground="White"
                                FontSize="16"
                                FontWeight="Bold"
                                Cursor="Hand"
                                Click="OnCloseMusicPlayerClick"/>
                    </Grid>
                </Border>

                <!-- YouTube Lo-Fi ボタン -->
                <StackPanel Grid.Row="1" Margin="12,10">
                    <TextBlock Text="YouTube Lo-Fi" FontWeight="SemiBold" FontSize="12" Foreground="#333" Margin="0,0,0,6"/>
                    <Button x:Name="LofiPlayButton"
                            Content="▶ Lofi Girl - beats to relax/study to"
                            Height="32"
                            Background="#FFFF6B6B"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="11"
                            Cursor="Hand"
                            Click="OnLofiPlayClick"/>
                </StackPanel>

                <!-- コントロール -->
                <StackPanel Grid.Row="2" Margin="12,0,12,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="1"
                                x:Name="MusicStopButton"
                                Content="⏹"
                                Width="40"
                                Height="40"
                                Background="#88333333"
                                Foreground="White"
                                BorderThickness="0"
                                FontSize="18"
                                Cursor="Hand"
                                Click="OnMusicStopClick"
                                ToolTip="停止"/>
                    </Grid>

                    <!-- 音量スライダー -->
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <TextBlock Text="🔊" FontSize="14" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <Slider x:Name="MusicVolumeSlider"
                                Width="180"
                                Minimum="0"
                                Maximum="100"
                                Value="30"
                                VerticalAlignment="Center"
                                ValueChanged="OnMusicVolumeChanged"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- YouTube埋め込み用WebView2（非表示） -->
        <wv2:WebView2 x:Name="YouTubeWebView"
                      Width="1" Height="1"
                      Visibility="Collapsed"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Top"/>

        <!-- 暫態訊息顯示區域 -->
        <Border x:Name="TransientBorder"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Margin="0,10,0,0"
                Background="#DD000000"
                CornerRadius="6"
                Padding="12,6"
                Visibility="Collapsed"
                Panel.ZIndex="300">
            <TextBlock x:Name="TransientMessage"
                       Foreground="White"
                       FontSize="12"
                       Text=""/>
        </Border>

        <!-- ウィジェットモード用パネル -->
        <Border x:Name="WidgetPanel"
                Visibility="Collapsed"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="#E8202030"
                CornerRadius="12"
                Padding="8"
                Panel.ZIndex="500">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- ヘッダー（時計・展開ボタン） -->
                <Grid Grid.Row="0">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock x:Name="WidgetTimeText"
                                   Text="12:00"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   VerticalAlignment="Center"/>
                        <TextBlock x:Name="WidgetDateText"
                                   Text="1/28"
                                   Foreground="#AAFFFFFF"
                                   FontSize="12"
                                   VerticalAlignment="Bottom"
                                   Margin="8,0,0,4"/>
                    </StackPanel>
                    <Button Content="⬜"
                            Width="24"
                            Height="24"
                            HorizontalAlignment="Right"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="White"
                            FontSize="14"
                            Cursor="Hand"
                            ToolTip="通常モードに戻る"
                            Click="OnExpandFromWidgetClick"/>
                </Grid>

                <!-- ステータスエリア -->
                <StackPanel Grid.Row="1" Margin="0,8,0,8">
                    <!-- 天気 -->
                    <Border x:Name="WidgetWeatherPanel"
                            Background="#33FFFFFF"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,0,4"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="WidgetWeatherIcon"
                                       Text="☀️"
                                       FontSize="16"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="WidgetWeatherText"
                                       Text="25°C"
                                       Foreground="White"
                                       FontSize="14"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <!-- 音楽ステータス -->
                    <Border x:Name="WidgetMusicPanel"
                            Background="#33FFFFFF"
                            CornerRadius="6"
                            Padding="8,4"
                            Margin="0,0,0,4"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🎵"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="WidgetMusicText"
                                       Text="Lofi Girl"
                                       Foreground="White"
                                       FontSize="12"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       MaxWidth="100"/>
                        </StackPanel>
                    </Border>

                    <!-- ポモドーロタイマー -->
                    <Border x:Name="WidgetPomodoroPanel"
                            Background="#33FF6B6B"
                            CornerRadius="6"
                            Padding="8,4"
                            Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🍅"
                                       FontSize="14"
                                       VerticalAlignment="Center"/>
                            <TextBlock x:Name="WidgetPomodoroText"
                                       Text="25:00"
                                       Foreground="White"
                                       FontSize="14"
                                       FontWeight="Bold"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- クイックアクションボタン -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="💬"
                            Width="32"
                            Height="32"
                            Margin="2"
                            Background="#44FFFFFF"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            ToolTip="チャット"
                            Click="OnWidgetChatClick"/>
                    <Button Content="🎵"
                            Width="32"
                            Height="32"
                            Margin="2"
                            Background="#44FFFFFF"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            ToolTip="音楽"
                            Click="OnWidgetMusicClick"/>
                    <Button Content="🍅"
                            Width="32"
                            Height="32"
                            Margin="2"
                            Background="#44FFFFFF"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="14"
                            Cursor="Hand"
                            ToolTip="ポモドーロ"
                            Click="OnWidgetPomodoroClick"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
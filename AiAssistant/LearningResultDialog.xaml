<Window x:Class="AiAssistant.LearningResultDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="学習結果"
        Height="600" Width="800"
        MinHeight="500" MinWidth="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        WindowStyle="ToolWindow"
        Background="#1E1E1E">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- タイトル -->
        <TextBlock x:Name="TitleText"
                   Grid.Row="0"
                   Text="学習結果"
                   Foreground="#4FC3F7"
                   FontSize="18"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- コンテンツ表示エリア -->
        <Border Grid.Row="1"
                BorderBrush="#3C3C3C"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <TextBox x:Name="ContentTextBox"
                         IsReadOnly="True"
                         TextWrapping="Wrap"
                         FontFamily="Consolas, 'MS Gothic', 'Yu Gothic UI', monospace"
                         FontSize="14"
                         Padding="15"
                         Background="#252526"
                         Foreground="#D4D4D4"
                         BorderThickness="0"
                         AcceptsReturn="True"/>
            </ScrollViewer>
        </Border>

        <!-- ボタンエリア -->
        <Grid Grid.Row="2" Margin="0,15,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- 左側：ノート保存ボタン -->
            <Button x:Name="SaveNoteButton"
                    Grid.Column="0"
                    Content="📝 ノートに保存"
                    Width="130"
                    Height="36"
                    Margin="0,0,10,0"
                    Click="SaveNoteButton_Click"
                    Background="#4CAF50"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontSize="13">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#66BB6A"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- コピーボタン -->
            <Button x:Name="CopyButton"
                    Grid.Column="1"
                    Content="📋 コピー"
                    Width="100"
                    Height="36"
                    Click="CopyButton_Click"
                    Background="#3C3C3C"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontSize="13">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#4C4C4C"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <!-- 右側：閉じるボタン -->
            <Button x:Name="CloseButton"
                    Grid.Column="3"
                    Content="閉じる"
                    Width="100"
                    Height="36"
                    Click="CloseButton_Click"
                    Background="#555"
                    Foreground="White"
                    BorderThickness="0"
                    Cursor="Hand"
                    FontSize="13">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#666"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </Grid>
    </Grid>
</Window>

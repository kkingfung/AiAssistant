<Window x:Class="AiAssistant.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="設定" Width="500" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F5F5F5">

    <Window.Resources>
        <!-- 共通スタイル -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1E90FF"/>
            <Setter Property="Margin" Value="0,12,0,8"/>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="120"/>
        </Style>

        <Style x:Key="SettingTextBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SettingComboBox" TargetType="ComboBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Background="#1E90FF" Padding="16,12">
            <TextBlock Text="⚙ 設定" Foreground="White" FontSize="18" FontWeight="Bold"/>
        </Border>

        <!-- 設定エリア（スクロール可能） -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="16,0">
            <StackPanel>

                <!-- アシスタント設定 -->
                <TextBlock Text="🎨 アシスタント設定" Style="{StaticResource SectionHeader}"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="テーマ:" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="ThemeComboBox" Width="200" Style="{StaticResource SettingComboBox}">
                        <ComboBoxItem Content="Light"/>
                        <ComboBoxItem Content="Dark"/>
                    </ComboBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="切り替え間隔(秒):" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="AnimationIntervalTextBox" Width="100" Style="{StaticResource SettingTextBox}"/>
                </StackPanel>

                <!-- ローカルLLM設定 -->
                <TextBlock Text="🤖 ローカルLLM設定 (Ollama)" Style="{StaticResource SectionHeader}"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="有効:" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="LocalLlmEnabledCheckBox" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="エンドポイント:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="OllamaEndpointTextBox" Width="250" Style="{StaticResource SettingTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="モデル:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="OllamaModelTextBox" Width="200" Style="{StaticResource SettingTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="ローカル優先:" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="PreferLocalCheckBox" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- OpenAI設定 -->
                <TextBlock Text="🌐 OpenAI設定" Style="{StaticResource SectionHeader}"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="APIキー:" Style="{StaticResource SettingLabel}"/>
                    <PasswordBox x:Name="OpenAiApiKeyBox" Width="300" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="モデル:" Style="{StaticResource SettingLabel}"/>
                    <ComboBox x:Name="OpenAiModelComboBox" Width="200" Style="{StaticResource SettingComboBox}" IsEditable="True">
                        <ComboBoxItem Content="gpt-4"/>
                        <ComboBoxItem Content="gpt-4-turbo"/>
                        <ComboBoxItem Content="gpt-3.5-turbo"/>
                    </ComboBox>
                </StackPanel>

                <!-- Google設定 -->
                <TextBlock Text="📧 Google設定 (Calendar/Gmail)" Style="{StaticResource SectionHeader}"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Client ID:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="GoogleClientIdTextBox" Width="300" Style="{StaticResource SettingTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Client Secret:" Style="{StaticResource SettingLabel}"/>
                    <PasswordBox x:Name="GoogleClientSecretBox" Width="300" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <!-- Anthropic設定 -->
                <TextBlock Text="📊 Anthropic設定 (組織API)" Style="{StaticResource SectionHeader}"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Admin APIキー:" Style="{StaticResource SettingLabel}"/>
                    <PasswordBox x:Name="AnthropicAdminKeyBox" Width="300" Height="28" VerticalContentAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="Organization ID:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="AnthropicOrgIdTextBox" Width="250" Style="{StaticResource SettingTextBox}"/>
                </StackPanel>

                <!-- 天気設定 -->
                <TextBlock Text="🌤 天気設定" Style="{StaticResource SectionHeader}"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="都市名:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="WeatherCityTextBox" Width="150" Style="{StaticResource SettingTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="緯度:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="WeatherLatTextBox" Width="100" Style="{StaticResource SettingTextBox}"/>
                    <TextBlock Text="経度:" Margin="20,0,0,0" Style="{StaticResource SettingLabel}" Width="40"/>
                    <TextBox x:Name="WeatherLonTextBox" Width="100" Style="{StaticResource SettingTextBox}"/>
                </StackPanel>

                <!-- 会話履歴設定 -->
                <TextBlock Text="💬 会話履歴設定" Style="{StaticResource SectionHeader}"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="履歴を保存:" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="SaveHistoryCheckBox" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="最大保存件数:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="MaxHistoryTextBox" Width="80" Style="{StaticResource SettingTextBox}"/>
                </StackPanel>

                <Button x:Name="ClearHistoryButton" Content="履歴をクリア"
                        Width="100" Height="28" Margin="120,8,0,0"
                        HorizontalAlignment="Left"
                        Click="OnClearHistoryClick"/>

                <!-- Live2D設定 (Phase 2) -->
                <TextBlock Text="🎭 Live2D設定" Style="{StaticResource SectionHeader}"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="有効:" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="Live2DEnabledCheckBox" VerticalAlignment="Center"/>
                    <TextBlock Text="(要Live2Dモデルファイル)" FontSize="10" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="モデルパス:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="Live2DModelPathTextBox" Width="250" Style="{StaticResource SettingTextBox}"/>
                    <Button x:Name="Live2DBrowseButton" Content="..." Width="30" Height="28" Margin="4,0,0,0" Click="OnLive2DBrowseClick"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="スケール:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="Live2DScaleTextBox" Width="80" Style="{StaticResource SettingTextBox}"/>
                    <TextBlock Text="(0.1 - 3.0)" FontSize="10" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 音声合成設定 (Phase 2) -->
                <TextBlock Text="🔊 音声合成設定 (VOICEVOX)" Style="{StaticResource SectionHeader}"/>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="有効:" Style="{StaticResource SettingLabel}"/>
                    <CheckBox x:Name="VoiceEnabledCheckBox" VerticalAlignment="Center"/>
                    <TextBlock Text="(要VOICEVOX起動)" FontSize="10" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="エンドポイント:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="VoicevoxEndpointTextBox" Width="250" Style="{StaticResource SettingTextBox}"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="話者ID:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="VoiceSpeakerIdTextBox" Width="80" Style="{StaticResource SettingTextBox}"/>
                    <TextBlock Text="(VOICEVOXのスタイルID)" FontSize="10" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="音量:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="VoiceVolumeTextBox" Width="80" Style="{StaticResource SettingTextBox}"/>
                    <TextBlock Text="(0.0 - 2.0)" FontSize="10" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4">
                    <TextBlock Text="速度:" Style="{StaticResource SettingLabel}"/>
                    <TextBox x:Name="VoiceSpeedTextBox" Width="80" Style="{StaticResource SettingTextBox}"/>
                    <TextBlock Text="(0.5 - 2.0)" FontSize="10" Foreground="Gray" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>

                <Separator Margin="0,16,0,8"/>

            </StackPanel>
        </ScrollViewer>

        <!-- フッターボタン -->
        <Border Grid.Row="2" Background="#E8E8E8" Padding="16,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="CancelButton" Content="キャンセル"
                        Width="100" Height="32" Margin="0,0,10,0"
                        Click="OnCancelClick"/>
                <Button x:Name="SaveButton" Content="保存"
                        Width="100" Height="32"
                        Background="#1E90FF" Foreground="White"
                        FontWeight="Bold"
                        Click="OnSaveClick"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
